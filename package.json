{
  "name": "litverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/unit.test.js tests/server.test.js tests/archive.test.js",
    "test:e2e": "playwright test",
    "dev:netlify": "npx --yes netlify-cli dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "gsap": "^3.0.0",
    "lucide": "^0.468.0",
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  }
}
