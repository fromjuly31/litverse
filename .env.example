# demo or live. Demo data stays in this browser; it is not a shared classroom.
VITE_APP_MODE=demo
# Default history routes for Vite/Netlify. build:pages sets hash routes automatically.
VITE_ROUTER_MODE=history
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public HTTPS origin for classroom QR links, without a trailing slash.
VITE_PUBLIC_SITE_URL=
# Netlify Functions only. NEVER prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate at least 32 random bytes. Do not rotate without invalidating existing links.
TOKEN_SECRET=
SITE_URL=

# Server-only AI synopsis. Do not expose this key in static HTML or VITE_ variables.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# Server-only deepening adapter. "custom" uses an HTTPS JSON endpoint (see README).
DEEPENING_AI_PROVIDER=openai
OPENAI_DEEPENING_MODEL=gpt-4.1-mini
DEEPENING_AI_URL=
DEEPENING_AI_KEY=
# Enable only after the operator reviews the selected provider's education/minor policy.
# Until enabled, students receive personalized teacher-reviewed questions without an AI call.
DEEPENING_STUDENT_AI_ENABLED=false
DEEPENING_AI_POLICY_REVIEWED_AT=
